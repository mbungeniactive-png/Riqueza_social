{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user preferences and basic information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "User's email" },
        "displayName": { "type": "string", "description": "User's display name" },
        "country": { "type": "string", "description": "Selected country code (ISO)" },
        "language": { "type": "string", "description": "Selected language code" },
        "aiCredits": { "type": "number", "description": "Available AI questions" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "Chat Message",
      "description": "A message in the mentor chat.",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["user", "model"] },
        "content": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["role", "content", "timestamp"]
    },
    "GeneratedVideo": {
      "title": "Generated Video",
      "description": "A video clip generated by the AI.",
      "type": "object",
      "properties": {
        "prompt": { "type": "string", "description": "The prompt used to generate the video" },
        "videoUrl": { "type": "string", "description": "The URL of the generated video" },
        "status": { "type": "string", "enum": ["pending", "completed", "failed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["prompt", "status", "createdAt"]
    },
    "GeneratedImage": {
      "title": "Generated Image",
      "description": "An image generated by the AI.",
      "type": "object",
      "properties": {
        "prompt": { "type": "string", "description": "The prompt used to generate the image" },
        "imageUrl": { "type": "string", "description": "The base64 or URL of the generated image" },
        "status": { "type": "string", "enum": ["pending", "completed", "failed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["prompt", "status", "createdAt"]
    },
    "TikTokInsight": {
      "title": "TikTok Insight",
      "description": "Trending insights for a specific niche on TikTok.",
      "type": "object",
      "properties": {
        "niche": { "type": "string" },
        "hashtags": { "type": "array", "items": { "type": "string" } },
        "trends": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "goldTip": { "type": "string" },
        "summary": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["niche", "hashtags", "trends", "goldTip", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document."
    },
    "/users/{userId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Messages with the AI mentor."
    },
    "/users/{userId}/videos/{videoId}": {
      "schema": "GeneratedVideo",
      "description": "Videos generated by the user."
    },
    "/users/{userId}/images/{imageId}": {
      "schema": "GeneratedImage",
      "description": "Images generated by the user."
    },
    "/users/{userId}/tiktok_insights/{insightId}": {
      "schema": "TikTokInsight",
      "description": "TikTok trends and insights searched by the user."
    }
  }
}
