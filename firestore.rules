rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isVerified() {
      return request.auth.token.email_verified == true;
    }

    // User Profile Validation
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
    && (data.keys().size() >= 4 && data.keys().size() <= 12)
    && data.uid == request.auth.uid
    && data.email is string && data.email.size() <= 256;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) 
    && isValidId(userId)
    && isValidUserProfile(incoming())
    && incoming().createdAt == request.time
    && incoming().updatedAt == request.time;
      
      allow update: if isOwner(userId)
    && isValidId(userId)
    && incoming().uid == existing().uid
    && incoming().createdAt == existing().createdAt
    && incoming().updatedAt == request.time
    && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'country', 'language', 'updatedAt', 'aiCredits']);
      
      match /messages/{messageId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) 
          && incoming().role in ['user', 'model']
          && incoming().content is string
          && incoming().content.size() <= 5000
          && incoming().timestamp == request.time;
        allow delete: if isOwner(userId);
      }

      match /videos/{videoId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && incoming().prompt is string
          && incoming().prompt.size() <= 1000
          && incoming().status == 'pending'
          && incoming().createdAt == request.time;
        allow update: if isOwner(userId)
          && incoming().status in ['pending', 'completed', 'failed']
          && (incoming().videoUrl == null || (incoming().videoUrl is string && incoming().videoUrl.size() <= 2000))
          && incoming().prompt == existing().prompt
          && incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId);
      }

      match /images/{imageId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && incoming().prompt is string
          && incoming().prompt.size() <= 1000
          && incoming().status == 'pending'
          && incoming().createdAt == request.time;
        allow update: if isOwner(userId)
          && incoming().status in ['pending', 'completed', 'failed']
          && (incoming().imageUrl == null || (incoming().imageUrl is string && incoming().imageUrl.size() <= 10000000)) // 10MB limit
          && incoming().prompt == existing().prompt
          && incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId);
      }

      match /tiktok_insights/{insightId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && incoming().niche is string
          && incoming().niche.size() <= 100
          && (incoming().hashtags == null || incoming().hashtags is list)
          && (incoming().summary == null || incoming().summary is string)
          && incoming().createdAt == request.time;
        allow delete: if isOwner(userId);
      }
    }
  }
}
